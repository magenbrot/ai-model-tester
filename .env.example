# ==============================================================================
# AI Model Availability Tester - Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
# and configure your API URL and token.

# Base URL of the API endpoint.
# Examples:
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Ollama:       http://localhost:11434/v1
#   vLLM:         http://localhost:8000/v1
#   LiteLLM:      http://localhost:4000/v1
#   Groq:         https://api.groq.com/openai/v1
#   Mistral:      https://api.mistral.ai/v1
API_BASE_URL=https://api.openai.com/v1

# Your API token / key (e.g. Bearer Token)
API_TOKEN=sk-your-token-here

# Comma-separated list of model IDs to ignore (e.g. audio/image/moderation models)
# Example: whisper-1,dall-e-3,text-moderation-latest
IGNORED_MODELS=whisper-1,dall-e-3,dall-e-2,tts-1,tts-1-hd,text-moderation-latest,text-moderation-stable

# Optional settings:
# Timeout per request in seconds (default: 15)
REQUEST_TIMEOUT=15

# Number of concurrent requests for testing (default: 3)
MAX_CONCURRENT=3

# Test message for chat/text models
TEST_PROMPT=Reply with 'OK' only.
